# Application dependencies and generated frontend (release ZIP includes the build)
**/node_modules/
/rebuild/public/assets/
/rebuild/public/index.html
/rebuild/public/uploads/
/dist/
# Private runtime configuration; examples stay tracked
.env
.env.*
!.env.example
/rebuild/config/local.php
/rebuild/config/launcher.local.json
/rebuild/config/nearby-httpd.conf
/rebuild/storage/*
!/rebuild/storage/.gitkeep
# Client records, exports and database runtime files
**/backups/
**/dumps/
*.sql.gz
*.sql.zip
*.sqlite
*.sqlite3
*.db
*.ibd
ibdata*
ib_logfile*
aria_log*
# SQL schema source is allowed only in the application schema folder
*.sql
!/rebuild/database/*.sql
# Credentials / recovery material and private keys
*.pem
*.key
*recovery-code*.txt
*recovery-sheet*.txt
# Conversation exports are private, not application source
/previousPrompts/
# Generated QA, downloads and local clutter
**/test-results/
**/__pycache__/
*.pyc
*.log
*.tmp
*.zip
*.bundle
*.patch
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Temporary Vite config generated by the recovery integration fixture
/rebuild/.recovery-test-vite.mjs
